# ---- Sarvam ----
SARVAM_API_KEY=
# 1 = run the voice pipeline with mocks (no Sarvam calls). Flip to 0 once the key works (M0).
VOICE_MOCK_MODE=1

# ---- Database (Railway provides this) ----
DATABASE_URL=

# ---- Razorpay (TEST MODE ONLY) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 1 = fake the payment link + "mark paid" (fallback if webhook can't reach us at M0).
PAYMENT_MOCK_MODE=1

# Public base URL of this deployment (used to build Razorpay callback/webhook URLs).
APP_BASE_URL=http://localhost:3000
