# Sarvam (required for the voice agent — get one at https://dashboard.sarvam.ai)
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional voice-agent tuning
SARVAM_LLM_MODEL=sarvam-30b
VOICE_AGENT_SPEAKER=priya

# Twilio (optional — only for the call-recording webhooks)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# your ngrok/public URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=
